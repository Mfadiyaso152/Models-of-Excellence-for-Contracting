rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: each user can read and write their own document
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Projects collection: clients can read and write projects assigned to them
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow read, write: if true;
    }
  }
}
